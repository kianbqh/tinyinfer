option(TINYC_LLM "Build standalone native GPT-2 runtime" OFF)
option(TINYC_LLM_CPU_TESTS "Build native artifact parser checks without CUDA" OFF)
if(TINYC_LLM)
  if(NOT TINYC_CUDA OR NOT TINYC_V2_CUDA)
    message(FATAL_ERROR "TINYC_LLM requires TINYC_CUDA=ON and TINYC_V2_CUDA=ON")
  endif()
  add_library(tinyinfer_llm SHARED llm/src/runtime.cu)
  target_include_directories(tinyinfer_llm PUBLIC llm/include PRIVATE llm/src backend/include)
  target_link_libraries(tinyinfer_llm PRIVATE tinyinfer_backend CUDA::cudart)
  target_compile_options(tinyinfer_llm PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:-O3;-allow-unsupported-compiler>")
  set_target_properties(tinyinfer_llm PROPERTIES CUDA_STANDARD 17 CUDA_ARCHITECTURES 86 BUILD_RPATH "$ORIGIN")
endif()
if(TINYC_LLM_CPU_TESTS)
  add_executable(tinyinfer_artifact_test llm/tests/test_artifact.cpp)
  target_include_directories(tinyinfer_artifact_test PRIVATE llm/src)
  target_compile_options(tinyinfer_artifact_test PRIVATE -UNDEBUG)
  add_test(NAME v2_artifact_parser COMMAND tinyinfer_artifact_test)
endif()
